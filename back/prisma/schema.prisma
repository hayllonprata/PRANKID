generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Settings {
  id           String   @id @default("default")
  whatsapp     String   @default("")
  yampiBaseUrl String   @default("")
  instagram    String   @default("")
  footer       String   @default("")
  openaiApiKey String   @default("")
  updatedAt    DateTime @updatedAt
}

model Hero {
  id        String   @id @default("default")
  title     String
  subtitle  String
  ctaText   String
  imageUrl  String   @default("")
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Story {
  id          String   @id @default("default")
  title       String
  description String
  imageUrl    String   @default("")
  updatedAt   DateTime @updatedAt
}

model LegendBeat {
  id        String   @id
  sortOrder Int
  title     String
  caption   String
  imageUrl  String   @default("")
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String   @default("")
  yampiToken  String   @default("")
  sku         String   @default("")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  personalized Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CustomBrief {
  id          String   @id @default(cuid())
  productId   String
  productName String
  job         String
  likes       String
  colors      String
  transcript  String   @default("")
  audioUrl    String   @default("")
  qty         Int      @default(1)
  createdAt   DateTime @default(now())
}

model CrewShot {
  id        String   @id @default(cuid())
  imageUrl  String
  caption   String   @default("")
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
